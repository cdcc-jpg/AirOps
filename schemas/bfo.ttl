@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<http://purl.obolibrary.org/obo/bfo.ttl> rdf:type owl:Ontology ;
    dcterms:title "Basic Formal Ontology (BFO 2020 Top-Level)"@en ;
    dcterms:description "BFO 2020 Top-Level taxonomy of Continuants, Occurrents, Independent & Dependent Continuants, Realizable Entities, Processes, and Spatial/Temporal Regions."@en ;
    owl:versionInfo "2020" .

#################################################################
#    BFO Top-Level Classes
#################################################################

### Entity (BFO_0000001)
obo:BFO_0000001 rdf:type owl:Class ;
    rdfs:label "Entity"@en ;
    rdfs:comment "An entity is anything that exists or has existed or will exist."@en .

### Continuant (BFO_0000002)
obo:BFO_0000002 rdf:type owl:Class ;
    rdfs:subClassOf obo:BFO_0000001 ;
    rdfs:label "Continuant"@en ;
    rdfs:comment "An entity that persists, endures, or continues to exist through time while maintaining its identity (e.g. players, replicas, fields, gear, rules)."@en .

### Occurrent (BFO_0000003)
obo:BFO_0000003 rdf:type owl:Class ;
    rdfs:subClassOf obo:BFO_0000001 ;
    rdfs:label "Occurrent"@en ;
    rdfs:comment "An entity that unfolds in time or has temporal parts (e.g. game sessions, eliminations, briefings, shooting windows, tactical operations)."@en .

### Independent Continuant (BFO_0000004)
obo:BFO_0000004 rdf:type owl:Class ;
    rdfs:subClassOf obo:BFO_0000002 ;
    rdfs:label "Independent Continuant"@en ;
    rdfs:comment "A continuant that is a bearer of qualities, roles, or dispositions and does not require another entity in order to exist (e.g. persons, objects, spatial sites)."@en .

### Material Entity (BFO_0000040)
obo:BFO_0000040 rdf:type owl:Class ;
    rdfs:subClassOf obo:BFO_0000004 ;
    rdfs:label "Material Entity"@en ;
    rdfs:comment "An independent continuant that has a material component (e.g. AirsoftPlayer, AirsoftReplica, AirsoftBB, EyeProtection)."@en .

### Immaterial Entity (BFO_0000141)
obo:BFO_0000141 rdf:type owl:Class ;
    rdfs:subClassOf obo:BFO_0000004 ;
    rdfs:label "Immaterial Entity"@en ;
    rdfs:comment "An independent continuant that lacks a material component, such as sites, spatial regions, or boundaries."@en .

### Spatial Region (BFO_0000006)
obo:BFO_0000006 rdf:type owl:Class ;
    rdfs:subClassOf obo:BFO_0000141 ;
    rdfs:label "Spatial Region"@en ;
    rdfs:comment "A 0D, 1D, 2D, or 3D spatial region such as a field zone, capture point, or spawn area."@en .

### Site (BFO_0000029)
obo:BFO_0000029 rdf:type owl:Class ;
    rdfs:subClassOf obo:BFO_0000141 ;
    rdfs:label "Site"@en ;
    rdfs:comment "A bounded spatial enclosure or location defined by surrounding physical objects, e.g. AirsoftField, CQBZone, SafeZone."@en .

### Specifically Dependent Continuant (BFO_0000020)
obo:BFO_0000020 rdf:type owl:Class ;
    rdfs:subClassOf obo:BFO_0000002 ;
    rdfs:label "Specifically Dependent Continuant"@en ;
    rdfs:comment "A continuant that inheres in a specific independent continuant bearer (e.g. player roles, chrono joule limits, dispositions, eye protection safety compliance)."@en .

### Realizable Entity (BFO_0000017)
obo:BFO_0000017 rdf:type owl:Class ;
    rdfs:subClassOf obo:BFO_0000020 ;
    rdfs:label "Realizable Entity"@en ;
    rdfs:comment "A specifically dependent continuant that inheres in its bearer and is realized in processes (e.g. roles, dispositions, capabilities)."@en .

### Role (BFO_0000023)
obo:BFO_0000023 rdf:type owl:Class ;
    rdfs:subClassOf obo:BFO_0000017 ;
    rdfs:label "Role"@en ;
    rdfs:comment "A realizable entity that exists because the bearer is in a social, legal, or tactical context (e.g. AirsoftMarshall, Team Captain, Sniper, VIP, Game Admin)."@en .

### Disposition (BFO_0000016)
obo:BFO_0000016 rdf:type owl:Class ;
    rdfs:subClassOf obo:BFO_0000017 ;
    rdfs:label "Disposition"@en ;
    rdfs:comment "A realizable entity that inheres in a material entity by virtue of its physical structure (e.g. replica firing capability, BB velocity, spring power)."@en .

### Quality (BFO_0000019)
obo:BFO_0000019 rdf:type owl:Class ;
    rdfs:subClassOf obo:BFO_0000020 ;
    rdfs:label "Quality"@en ;
    rdfs:comment "A specifically dependent continuant that is not realizable, but describes an intrinsic attribute (e.g. muzzle energy in Joules, BB weight in grams, player callsign)."@en .

### Generically Dependent Continuant (BFO_0000031)
obo:BFO_0000031 rdf:type owl:Class ;
    rdfs:subClassOf obo:BFO_0000002 ;
    rdfs:label "Generically Dependent Continuant"@en ;
    rdfs:comment "A continuant that depends on an independent continuant bearer but can be copied or instantiated elsewhere (e.g. AirsoftRule, game rulebook, tactical plan)."@en .

### Process (BFO_0000015)
obo:BFO_0000015 rdf:type owl:Class ;
    rdfs:subClassOf obo:BFO_0000003 ;
    rdfs:label "Process"@en ;
    rdfs:comment "An occurrent that exists in time by unfolding in temporal phases or stages (e.g. GameSession, TacticalOperation, ChronoCheck, PlayerElimination)."@en .

### Process Boundary (BFO_0000035)
obo:BFO_0000035 rdf:type owl:Class ;
    rdfs:subClassOf obo:BFO_0000003 ;
    rdfs:label "Process Boundary"@en ;
    rdfs:comment "An instantaneous temporal boundary of a process (e.g. GameStart, GameEnd, ObjectiveCaptured, Kill Event)."@en .

### Temporal Region (BFO_0000008)
obo:BFO_0000008 rdf:type owl:Class ;
    rdfs:subClassOf obo:BFO_0000003 ;
    rdfs:label "Temporal Region"@en ;
    rdfs:comment "A temporal interval or instant during which occurrents take place (e.g. shooting window, game duration)."@en .

### Temporal Interval (BFO_0000028)
obo:BFO_0000028 rdf:type owl:Class ;
    rdfs:subClassOf obo:BFO_0000008 ;
    rdfs:label "Temporal Interval"@en ;
    rdfs:comment "A continuous one-dimensional region of time (e.g. 15-minute game period, 1-hour lunch break)."@en .

### Temporal Instant (BFO_0000038)
obo:BFO_0000038 rdf:type owl:Class ;
    rdfs:subClassOf obo:BFO_0000008 ;
    rdfs:label "Temporal Instant"@en ;
    rdfs:comment "A zero-dimensional point in time (e.g. timestamp of chrono scan, timestamp of hit call)."@en .


#################################################################
#    BFO Object Properties
#################################################################

### BFO_0000050 (part of)
obo:BFO_0000050 rdf:type owl:ObjectProperty ;
    rdfs:label "part of"@en ;
    owl:inverseOf obo:BFO_0000051 ;
    rdfs:comment "a core relation between continuants or occurrents where one is a part of another."@en .

### BFO_0000051 (has part)
obo:BFO_0000051 rdf:type owl:ObjectProperty ;
    rdfs:label "has part"@en ;
    rdfs:comment "inverse of part of."@en .

### BFO_0000056 (participates in)
obo:BFO_0000056 rdf:type owl:ObjectProperty ;
    rdfs:label "participates in"@en ;
    rdfs:domain obo:BFO_0000002 ; # Continuant
    rdfs:range obo:BFO_0000003 ;  # Occurrent
    owl:inverseOf obo:BFO_0000057 ;
    rdfs:comment "relates a continuant to an occurrent process in which it is involved."@en .

### BFO_0000057 (has participant)
obo:BFO_0000057 rdf:type owl:ObjectProperty ;
    rdfs:label "has participant"@en ;
    rdfs:domain obo:BFO_0000003 ;  # Occurrent
    rdfs:range obo:BFO_0000002 ;   # Continuant
    rdfs:comment "relates a process to the continuants involved in it."@en .

### BFO_0000066 (occurs in)
obo:BFO_0000066 rdf:type owl:ObjectProperty ;
    rdfs:label "occurs in"@en ;
    rdfs:domain obo:BFO_0000003 ;  # Occurrent
    rdfs:range obo:BFO_0000004 ;   # Independent Continuant or Spatial Region
    rdfs:comment "relates an occurrent process to the spatial location or independent continuant where it takes place."@en .

### BFO_0000054 (realized in)
obo:BFO_0000054 rdf:type owl:ObjectProperty ;
    rdfs:label "realized in"@en ;
    rdfs:domain obo:BFO_0000017 ;  # Realizable Entity
    rdfs:range obo:BFO_0000015 ;   # Process
    rdfs:comment "relates a role or disposition to the process that executes it."@en .

### BFO_0000055 (realizes)
obo:BFO_0000055 rdf:type owl:ObjectProperty ;
    rdfs:label "realizes"@en ;
    rdfs:domain obo:BFO_0000015 ;  # Process
    rdfs:range obo:BFO_0000017 ;   # Realizable Entity
    rdfs:comment "relates a process to the role or disposition it realizes."@en .

### BFO_0000196 (bearer of)
obo:BFO_0000196 rdf:type owl:ObjectProperty ;
    rdfs:label "bearer of"@en ;
    rdfs:domain obo:BFO_0000004 ;  # Independent Continuant
    rdfs:range obo:BFO_0000020 ;   # Specifically Dependent Continuant
    rdfs:comment "relates an independent entity to its roles, qualities, or dispositions."@en .
